# Copy to .env and fill in. Never commit .env (it is git-ignored).

# The app, locally and in Vercel. Supabase dashboard: Settings > API Keys (or the Connect dialog).
# The publishable key (sb_publishable_...) is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scripts only (npm run supabase -- ...), never in Vercel or the browser: a personal access token from
# https://supabase.com/dashboard/account/tokens. The script uses it to create the test project, apply
# migrations, switch off email confirmation and fetch keys.
SUPABASE_ACCESS_TOKEN=

# Server-only secret key (sb_secret_...) of the live project, for the seed script (T6).
# Never prefix it with NEXT_PUBLIC_. Written by: npm run supabase -- keys live
SUPABASE_SECRET_KEY=

# The separate test project for integration and end-to-end tests, so tests never touch live data.
# Written by: npm run supabase -- create-test-project. CI reads the first three from repository secrets.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
TEST_SUPABASE_DB_PASSWORD=

# The password of every demo user that the seed script creates (npm run db:seed -- live|test, T6).
# Only for the seed: server-only, never in Vercel, the browser or a NEXT_PUBLIC_ variable. Use two
# different values, so the live password never sits in the test project. 8 characters to 72 bytes.
# The integration tests do not read them; they seed with a fresh random password each run.
SEED_DEMO_PASSWORD=
TEST_SEED_DEMO_PASSWORD=

# Email (T9b). Customers order without a password: Supabase emails them a 6-digit code.
# Live: the codes go out through Brevo's SMTP (npm run supabase -- smtp live), and the app sends the
# order confirmation through Brevo's API. Brevo dashboard > SMTP & API. EMAIL_FROM is a sender address
# verified in Brevo, e.g. "HomeKlin <you@example.com>". Server only; set BREVO_API_KEY, EMAIL_FROM and
# SITE_URL in Vercel too. Without BREVO_API_KEY no confirmation email is sent (tests, CI).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_API_KEY=
EMAIL_FROM=
# The site's address, for the link in the confirmation email (default https://home-klin.vercel.app).
SITE_URL=

# Test project only: a throw-away Ethereal SMTP account (npm run supabase -- ethereal), so tests never
# send real email. Written by the script; only the script uses it.
ETHEREAL_SMTP_USER=
ETHEREAL_SMTP_PASS=
